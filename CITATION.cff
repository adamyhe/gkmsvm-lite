    title: "Enhanced regulatory sequence prediction using gapped k-mer features"
    authors:
      - given-names: Mahmoud
        family-names: Ghandi
      - given-names: Dongwon
        family-names: Lee
      - given-names: Morteza
        family-names: Mohammad-Noori
