  - type: article
    title: "LS-GKM: a new gkm-SVM for large-scale datasets"
    authors:
      - given-names: Dongwon
        family-names: Lee
    journal: Bioinformatics
    volume: 32
    issue: 14
    start: 2196
    end: 2198
    year: 2016
    doi: 10.1093/bioinformatics/btw142
    scope: "LS-GKM C implementation — estimated/truncated kernels, model format, scalable training."

  - type: article
    title: "GkmExplain: fast and accurate interpretation of nonlinear gapped k-mer SVMs"
    authors:
      - given-names: Avanti
        family-names: Shrikumar
      - given-names: Eva
        family-names: Prakash
      - given-names: Anshul
