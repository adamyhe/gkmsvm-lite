    issue: 14
    start: i173
    end: i182
    year: 2019
    doi: 10.1093/bioinformatics/btz322
    scope: "GkmExplain attribution — analytical decomposition of gkm-SVM decisions."

  - type: article
    title: "A method to predict the impact of regulatory variants from DNA sequence"
    authors:
      - given-names: Dongwon
        family-names: Lee
      - given-names: David U.
        family-names: Gorkin
      - given-names: Maggie
        family-names: Baker
